{
  "expo": {
    "name": "Deep End",
    "slug": "deep-end",
    "owner": "deep-end",
    "version": "1.0.0",
    "runtimeVersion": {
      "policy": "fingerprint"
    },
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.deependspanish.app",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.deependspanish.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      [
        "expo-audio",
        {
          "microphonePermission": "Allow $(PRODUCT_NAME) to use your microphone so you can record yourself speaking Spanish and compare it with the model. Recordings stay on your device."
        }
      ]
    ],
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#8B0000"
    },
    "extra": {
      "eas": {
        "projectId": "e7ebda80-73d0-4580-ba04-a4e1b55a4f87"
      }
    },
    "updates": {
      "url": "https://u.expo.dev/e7ebda80-73d0-4580-ba04-a4e1b55a4f87"
    }
  }
}
